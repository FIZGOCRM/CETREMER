# ==============================================================================
# CETREMER - Variáveis de Ambiente (.env)
# ==============================================================================

# Modo de desenvolvimento (True ou False)
DEBUG=True

# Chave secreta do Django (gerar uma chave segura para produção)
SECRET_KEY=

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Hosts permitidos separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Endereço público do site, usado nos links dos e-mails enviados pelos comandos agendados (ex.: https://escola.exemplo.com.br)
SITE_URL=

# Porta padrão de execução local
PORT=8000
