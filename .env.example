# ==============================================================================
# CETREMER - Variáveis de Ambiente (.env)
# ==============================================================================

# Modo de desenvolvimento (True ou False)
DEBUG=True

# Chave secreta do Django (gerar uma chave segura para produção)
SECRET_KEY=

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Hosts permitidos separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Porta padrão de execução local
PORT=8000

# Asaas: consultas e recebimento de eventos, sem criação de cobranças nesta etapa.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_ENABLED=False
ASAAS_API_KEY=
ASAAS_WEBHOOK_ENABLED=False
# Segredo próprio, diferente da API key: 32 a 255 caracteres sem espaços.
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT=10

# Opcional: demonstração local em banco separado (não habilitar na operação real).
# DJANGO_DATABASE_PATH=C:/caminho/gomut-demo.sqlite3
GOMUT_DEMO_MODE=False
